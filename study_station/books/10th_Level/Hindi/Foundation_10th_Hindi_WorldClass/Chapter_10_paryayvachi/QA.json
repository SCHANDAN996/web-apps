    "editorial:Content_hi.txt": {
      "fingerprint": "e7e22c3f10772602d1741b609f51d2536aaf1b1694d4cb23c5de5cc6d06f9efc",
      "kind": "editorial",
      "status": "blocked",
      "issues": [
        "- उदाहरण 2 के हल में \"मरीच = किरण/सूर्य\" लिखा है, जो तथ्यात्मक रूप से गलत है; मरीच सूर्य का मानक पर्याय नहीं है (यह ऋषि या काली मिर्च का नाम है) → इस कथन को हटाएं या सही करें कि मरीच वायु का पर्याय नहीं है।",
        "- सूर्य के पर्याय के लिए दिया गया स्मरण सूत्र \"भरदिया\" सूचीबद्ध शब्दों (भास्कर, रवि, दिनकर, आदित्य) के प्रारंभिक अक्षरों (भ, र, द, आ) से मेल नहीं खाता → सही संक्षेप \"भरदआ\" या कोई अन्य उपयुक्त स्मरण सूत्र बनाएं।",
        "- क्षेत्रीय/बोलचाल पर्याय की तालिका में \"अन्न\" को \"भात/चावल\" का पर्याय बताया गया है, जबकि \"अन्न\" का अर्थ \"अनाज/भोजन\" है न कि विशेषतः चावल → \"अन्न\" को इस सूची से हटाएं या स्पष्ट करें कि यह सामान्य अर्थ में प्रयुक्त होता है।"
      ],
