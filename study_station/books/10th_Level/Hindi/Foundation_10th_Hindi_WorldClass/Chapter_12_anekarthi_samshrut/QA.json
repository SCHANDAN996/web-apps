    "editorial:Important_Rules_hi.txt": {
      "fingerprint": "d880da7ff6997f5205cb25ef563691c516dd360ec700dcc51ef0a2ea0a35515f",
      "kind": "editorial",
      "status": "blocked",
      "issues": [
        "- नियम २, नियम ११ और सारणी में \"हँस\" (हँसना) और \"हंस\" (पक्षी) के वर्तनी-भेद को \"चंद्रबिंदु/बिंदु भेद\" बताया गया है, जबकि \"हंस\" (पक्षी) की मानक वर्तनी बिना किसी बिंदु के \"हंस\" होती है; अंतर चंद्रबिंदु की उपस्थिति/अनुपस्थिति का है, न कि चंद्रबिंदु बनाम बिंदु का। → \"हँस\" (चंद्रबिंदु सहित) बनाम \"हंस\" (बिना बिंदु) — केवल चंद्रबिंदु का भेद।",
        "- नियम १३ में दावा कि शब्दकोश में \"कल\" का पहला अर्थ \"बीता हुआ दिन\" है, गलत है; मानक हिंदी शब्दसागर व मानक हिंदी शब्दकोश में \"कल\" की पहली प्रविष्टि \"कलह\" (झगड़ा) है, उसके बाद कालवाचक क्रियाविशेषण \"कल\" (कल/आज) आता है। → शब्दकोश क्रम में \"कल\" का प्रथम अर्थ \"कलह\" है, \"बीता हुआ दिन\" नहीं।"
      ],
