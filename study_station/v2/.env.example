# Study Station v2 — copy to .env and fill in. NEVER commit .env.

# Public address (canonical links, sitemap, alert links)
SITE_URL=https://studystation.in

# Database (SQLite default is fine for one server; PostgreSQL: postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:////var/lib/studystation/studystation.db

# Cookies only over HTTPS (set 0 only for local http testing)
COOKIE_SECURE=1

# Admin panel (/admin) — stays locked until both are set.
# SECRET_KEY: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_PASSWORD=

# AI (tutor, question generator, current-affairs summaries) — optional; features stay off when empty.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT_PER_DEVICE=20
AI_DAILY_LIMIT_TOTAL=2000

# Telegram alerts (python -m app.jobs digest --telegram) — optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@YourChannel

# Job sources to skip, comma-separated (see app/jobs/sources.py)
JOB_SOURCES_DISABLED=

# Where admin-triggered runs write logs
LOG_DIR=/var/log/studystation
