# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Telegram job-alert broadcasting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@YourChannelUsername
IS_TELEGRAM_ENABLED=false

# AI keys (used by content generation scripts)
GEMINI_API_KEY=

# Admin panel login (admin stays LOCKED until both are set)
# Generate SECRET_KEY with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_PASSWORD=

# Origins allowed to call /api/* from a browser (comma-separated)
ALLOWED_ORIGINS=https://studystation.in,https://www.studystation.in

# Set to 1 when running behind nginx so rate limits see the real client IP
TRUST_PROXY=1

# Session cookie is HTTPS-only by default; set 0 only for local http testing
COOKIE_SECURE=1
